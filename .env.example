# ---------------------------------------------------------------- runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Local dev: `npm run dev:db` starts a single-node replica set (transactions need one).
MONGODB_URI=mongodb://127.0.0.1:27018/sverse?replicaSet=sverse-dev
PUBLIC_ASSET_BASE=http://127.0.0.1:4000
APP_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5174,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:5174
# Set for cross-subdomain cookies in deployed environments, e.g. .sverse.io
COOKIE_DOMAIN=
# lax (same-site app + API, e.g. app.sverse.io + api.sverse.io) | none (cross-site, forces Secure)
COOKIE_SAMESITE=lax
# Run background jobs in this process (set false on API replicas when a worker runs).
RUN_JOBS=true
SEED_ON_BOOT=false

# ---------------------------------------------------------------- secrets (≥32 chars each, required in production)
JWT_ACCESS_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-at-least-32-characters
ENTITLEMENT_SECRET=replace-with-at-least-32-characters
WEBHOOK_SIGNING_PEPPER=replace-with-at-least-32-characters

# ---------------------------------------------------------------- economics
SRV_USD_RATE=0.042
MIN_LISTING_BOND_UNITS=250000000
KYC_THRESHOLD_UNITS=50000000000
DISPUTE_WINDOW_DAYS=30
PROTOCOL_FEE_BPS_STANDARD=1000
PROTOCOL_FEE_BPS_STAKED=700
PROTOCOL_FEE_BPS_PREMIUM=500
MARKET_PROTOCOL_FEE_BPS=250
BOOTSTRAP_EMISSION_UNITS=0
REWARDS_GENESIS_DATE=2026-01-05T00:00:00.000Z
REWARD_CLAIM_WINDOW_DAYS=90
QUOTE_TTL_SECONDS=120
# Testnet SRV faucet (1,000 SRV / 24h per passport). Disable on mainnet.
FAUCET_ENABLED=true
FAUCET_AMOUNT_UNITS=1000000000

# ---------------------------------------------------------------- chain
# mock | avalanche
CHAIN_ADAPTER=mock
MOCK_CHAIN_LATENCY_MS=40
# HD root for custodial passport/studio wallets. KEEP IN A SECRET MANAGER. Required for avalanche
# outside local chains and always in production. Generate with:
#   node -e "import('ethers').then(e=>console.log(e.Wallet.createRandom().mnemonic.phrase))"
CUSTODY_MNEMONIC=
# Relayer: holds PLATFORM/MINTER (items), WITNESS (deeds), PUBLISHER (rewards), MINTER (tSRV).
RELAYER_PRIVATE_KEY=
AVALANCHE_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
AVALANCHE_CHAIN_ID=43113
AVALANCHE_EXPLORER_URL=https://subnets-test.avax.network/c-chain
AVALANCHE_CONFIRMATIONS=1
# Either point at the Hardhat deployment manifest…
AVALANCHE_DEPLOYMENT_FILE=../smartcontract/deployments/fuji.json
# …or set addresses explicitly (these win over the manifest).
SRV_TOKEN_ADDRESS=
SVERSE_ITEMS_ADDRESS=
SVERSE_DEED_REGISTRY_ADDRESS=
SVERSE_STORE_ADDRESS=
SVERSE_MARKETPLACE_ADDRESS=
SVERSE_REWARDS_ADDRESS=
AVALANCHE_START_BLOCK=
# mint (testnet: payouts and reward funding mint tSRV) | transfer (mainnet: from reserve wallet)
SRV_SETTLEMENT_MODE=mint
CUSTODIAL_GAS_TOPUP_WEI=20000000000000000
CUSTODIAL_GAS_MIN_WEI=5000000000000000

# ---------------------------------------------------------------- demo seed
SEED_ADMIN_EMAIL=ops@sverse.local
SEED_ADMIN_PASSWORD=
GEMINI_API_KEY=
SEED_IMAGE_MODEL=gemini-2.5-flash-image
