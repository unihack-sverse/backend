{
  "name": "@sverse/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "worker": "node src/worker.js",
    "build": "node scripts/check-syntax.js",
    "check": "node scripts/check-syntax.js",
    "lint": "node scripts/check-syntax.js && eslint --max-warnings=0 .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:chain": "vitest run --config vitest.chain.config.js",
    "seed:reset": "node scripts/reseed.js",
    "dev:db": "node scripts/dev-db.js",
    "db:sync-indexes": "node scripts/sync-indexes.js"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.15.0",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.2",
    "pino": "^9.3.2",
    "pino-http": "^10.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.36.0",
    "globals": "^16.4.0",
    "mongodb-memory-server": "^10.2.0",
    "supertest": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
